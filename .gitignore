.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Competition data. `data/raw` is a symlink to /data/mgr/enveda-casmi/raw, so git would
# otherwise want to track the link itself — but the bytes behind it are 3 GB of
# train.parquet under CC BY-NC 4.0, and test.parquet carries its own separate
# noncommercial restriction. Neither goes near a remote.
data/raw

# Derived artefacts: regenerated by a script, never edited by hand, always safe to
# delete. A stale derived file must not outlive the code that made it.
data/processed/

# Candidate databases and model checkpoints pulled from Kaggle datasets — COCONUT,
# PubChemLite, ChEBI/LIPID MAPS, FPNet/ICEBERG/GLACIER weights. Tens of GB between
# them, all refetchable with one `kaggle datasets download`. The manifest that says
# *which* ones we use is in docs/, and that is the part worth versioning.
data/candidates/
models/

# Run outputs: submissions, logs, per-molecule candidate audits.
out/
*.ckpt
submission*.csv

# Installed in editable mode, so setuptools leaves this behind.
*.egg-info/

# Left by scripts/rehearse_kernel.py when it exercises the zip mount shape.
/lib/
